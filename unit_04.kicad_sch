	(text "HCLK_03:  10.0012 MHz, 0/3.3 V, this channel's own length-matched branch off the fan-out"
		(exclude_from_sim no)
		(at 288.2900 161.2900 0)
		(effects
			(font
				(size 1.5000 1.5000)
				(italic yes)
