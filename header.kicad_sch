	(text "W19   IO_L22N_T3_34   I2C SCL - 2k2 pull-up already on PYNQ-Z2"
		(exclude_from_sim no)
		(at 255.27 73.66 0)
		(effects
			(font
				(size 1.2 1.2)
				(italic yes)
			)
			(justify right bottom)
		)
		(uuid "f0d42882-5b29-0ca8-72e7-eddfb91a9447")
	)
	(text "B19   IO_L2P_T0_AD8P_35   unit 7 pps"
		(exclude_from_sim no)
		(at 346.71 111.76 0)
		(effects
			(font
