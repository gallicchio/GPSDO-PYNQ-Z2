	(text "0.77 Vpp, 0 to +0.77 V at TP_XA -"
		(exclude_from_sim no)
		(at 88.9000 121.9200 0)
		(effects
			(font
				(size 1.3000 1.3000)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "398a2e8c-9919-1ba8-2282-a9878ea16a43")
	)
	(text "the level the Si5351 actually sees, AC coupled"
		(exclude_from_sim no)
		(at 88.9000 125.7300 0)
		(effects
			(font
				(size 1.3000 1.3000)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "196fa4ef-c706-0cbb-abed-3faadc89c445")
	)
	(text_box "DRIVING XA IS NOT A DOCUMENTED MODE, AND TP_XA IS WHY.\nThe Si5351A has no CLKIN pin - only the Si5351C does - so an external reference\nhas to go into the crystal oscillator input.  XA/XB are absolute-maximum -0.5 to\n+1.3 V, so the 3k3/1k knocks the TCXO's 3.3 V CMOS down to 0.77 Vpp FIRST and\nthe 10 nF then AC-couples it in, leaving XA's own internal bias intact.  Order\nmatters: the 1k must sit on the divider, not on XA.\nSilicon Labs publish no level for this, so it is measured, not calculated.\nProbe TP_XA, which is on the DRIVEN side of the coupling cap where 10 pF of\nprobe does nothing; probing XA itself would pull the oscillator.  If the swing\nis outside the window, change the 1k - 620R gives 0.52 Vpp.  If it will not run\nat all, fit Y3001 and drop the TCXO: that is the documented mode, at the cost of\n+/-10 ppm."
		(exclude_from_sim no)
		(at 210.8200 45.7200 0)
		(size 121.9200 34.2900)
		(margins 0.9525 0.9525 0.9525 0.9525)
