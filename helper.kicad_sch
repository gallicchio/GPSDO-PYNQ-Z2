	(text_box "CLK1 IS THE NULL-CHANNEL SOURCE.\nSet it to exactly 10.000000 MHz and patch this SMA to channel 13 with a short coax.  CLK1 and the\nhelper CLK0 come off the same PLL, so their beat is exact and noiseless and anything channel 13\nreports is this board alone.  Doing it with a cable rather than a jumper keeps every channel tile\nidentical and puts a real connector and cable in the loop, which is the honest thing to measure."
		(exclude_from_sim no)
		(at 400.0500 45.7200 0)
		(size 170.1800 15.2400)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 220 235 255 1)
		)
		(effects
			(font
				(size 1.4000 1.4000)
			)
			(justify left top)
		)
		(uuid "ab43bc72-6696-6a64-831a-6180404f125e")
	)
