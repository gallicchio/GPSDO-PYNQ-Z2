	(text "0.77 Vpp, 0 to +0.77 V at TP_XA -"
		(exclude_from_sim no)
		(at 88.9000 121.9200 0)
		(effects
			(font
				(size 1.3000 1.3000)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "398a2e8c-9919-1ba8-2282-a9878ea16a43")
	)
	(text "the level the Si5351 actually sees, AC coupled"
		(exclude_from_sim no)
		(at 88.9000 125.7300 0)
		(effects
			(font
				(size 1.3000 1.3000)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "196fa4ef-c706-0cbb-abed-3faadc89c445")
	)
	(text_box "DRIVING XA WITH A REFERENCE IS A DOCUMENTED MODE.  Si5351 datasheet 6.6,\n'Applying a Reference Clock at XTAL Input': 1 Vpp AC-coupled into XA, XB open -\nwhich is this circuit.  (Rounds 17-27 said it was undocumented; two of round\n28's reviewers repeated that.)  The Si5351A has no CLKIN pin - only the C does -\nso XA is the input.  XA/XB are absolute-maximum -0.5 to +1.3 V and the pin's own\nbias point is not published: 0.77 Vpp (3k3/1k from 3.3 V CMOS, then the 10 nF)\nis the largest swing that stays under 1.3 V even if the bias is as high as 0.9\nV, and it is within 30 percent of the datasheet's figure.  Order matters: the 1k\nmust sit on the divider, not on XA.\nProbe TP_XA, on the DRIVEN side of the coupling cap where 10 pF of probe does\nnothing; probing XA itself would pull the oscillator.  If the part will not\nstart at 0.77 Vpp, 1k -> 1k3 gives 0.93 Vpp.  If it will not run at all, fit\nY3001 and drop the TCXO: +/-10 ppm, which cannot avoid the 60 Hz comb."
		(exclude_from_sim no)
		(at 210.8200 45.7200 0)
		(size 121.9200 36.8300)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 220 220 1)
		)
		(effects
			(font
				(size 1.4000 1.4000)
			)
			(justify left top)
		)
		(uuid "d8d51b24-f9bf-79d5-5d27-e51deb88b54d")
	)
