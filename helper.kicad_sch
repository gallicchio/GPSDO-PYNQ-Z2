		(uuid "0f8b8771-304e-fdf6-50a2-5e3bb535dae8")
	)
	(text "PLLA <- CLKIN, 32 + 1543/390625, MultiSynth0 80 -> CLK0 = 10.0012344 MHz, 2 mA (O10)"
		(exclude_from_sim no)
		(at 120.65 139.7 0)
		(effects
			(font
				(size 1.3 1.3)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "2d8fed09-ecfd-2e91-7190-405fc5ad0408")
	)
	(text "PLLB <- CLKIN, x32 integer, MultiSynth2 80 -> CLK2 = 10.000000 MHz (HO), 2 mA (O6)"
		(exclude_from_sim no)
		(at 120.65 143.51 0)
		(effects
			(font
				(size 1.3 1.3)
				(italic yes)
