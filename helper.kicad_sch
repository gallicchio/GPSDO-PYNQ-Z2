		)
		(uuid "3ef540c3-128f-a948-7cb0-bdde6331c32d")
	)
	(text "I2C address 0x60.  Programmed at every power-up from the PYNQ:"
		(exclude_from_sim no)
		(at 120.65 135.89 0)
		(effects
			(font
				(size 1.3 1.3)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "53f730a5-136b-cdf3-dedb-a19d334f1a41")
	)
	(text "HELPER OSCILLATOR AND FAN-OUT  (rev B)"
		(exclude_from_sim no)
		(at 15.24 20.32 0)
		(effects
			(font
				(size 3.6 3.6)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "6872cffc-dbf8-2a96-b6ac-67482e4ac206")
	)
	(text "TCXO -> Si5351C CLKIN -> CLK0 10.0012344 MHz -> squarer -> TWO LMK1C1108 side by side -> 14 series-terminated branches.  Helper skew enters the measurement 1:1, so the fan-out is ONE part family on ONE supply that no channel shares (item 22)."
		(exclude_from_sim no)
		(at 15.24 26.67 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "6895168f-0a73-9751-5dfb-2cced21b60de")
	)
	(text "10.0012344 MHz, 0/3.3 V CMOS, Si5351 CLK0"
		(exclude_from_sim no)
		(at 40.64 193.04 0)
		(effects
			(font
				(size 1.3 1.3)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "6c3da753-1222-504a-3c48-7b572dd34e67")
	)
	(text "the same replica-biased squarer as every channel (item 18), on the fan-out's own supply"
		(exclude_from_sim no)
		(at 132.08 228.6 0)
		(effects
			(font
				(size 1.3 1.3)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "7543aee2-5b70-da3d-b1c3-a35397d6c831")
	)
	(text "FAN-OUT      2 x LMK1C1108 side by side, one input, 14 branches series terminated, on FO_VDD"
		(exclude_from_sim no)
		(at 19.05 251.46 0)
		(effects
			(font
				(size 2.6 2.6)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "d7a4c754-d33a-b67a-91df-dbe90b24e0fa")
	)
	(text "SOURCE SELECT AND SQUARER      fit exactly one 0R"
		(exclude_from_sim no)
		(at 19.05 162.56 0)
		(effects
			(font
