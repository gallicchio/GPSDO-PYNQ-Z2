			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 225 240 225 1)
		)
		(effects
			(font
				(size 2.0000 2.0000)
			)
			(justify left top)
		)
		(uuid "002d9648-903a-17a1-56e0-806cd0b7a179")
	)
