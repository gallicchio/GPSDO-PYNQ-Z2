	)
	(text_box "THE BAV99 CLAMP IS DNP.\nFit only on a channel you will run UNTERMINATED with a source above about 6 Vpp\nopen circuit.  It is not fitted by default because its reverse leakage flows in\nthe 1M self-bias resistor: 10 nA is 10 mV of bias shift, leakage roughly doubles\nevery 10 degC, and at 63 mV/ns that would swamp the whole long-tau drift budget."
		(exclude_from_sim no)
		(at 15.24 204.47 0)
		(size 121.92 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 245 210 1)
		)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "b907930d-d045-9016-0310-c47fe7295485")
	)
	(text_box "AT THE GATE, at TP_SQ\n2.00 Vpp, center 1.65 V\n0.65 to 2.65 V\nslew 63 mV/ns"
		(exclude_from_sim no)
		(at 172.72 78.74 0)
		(size 46.99 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
