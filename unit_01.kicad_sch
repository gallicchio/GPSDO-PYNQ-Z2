	(text_box "PER-CHANNEL NOTE\n8.0 Vpp OPEN CIRCUIT - the hottest source here.  The 50R TERM jumper MUST be fitted on this channel: unterminated it floats the gate to about +7.4 V, over the 6.5 V absolute maximum."
		(exclude_from_sim no)
		(at 365.76 12.7 0)
		(size 213.36 20.32)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
