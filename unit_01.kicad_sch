	(text_box "AT THE INPUT NODE, before the coupling\ncap\n2.00 Vpp, center 0 V\nTERMINATED\nload 51R || 2k2 = 49.8 ohm"
		(exclude_from_sim no)
		(at 76.2 78.74 0)
