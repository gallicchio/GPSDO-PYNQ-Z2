# Everything under build/ is generated by build.tcl, sim.tcl or bringup.tcl.
# The bitstream and the .hwh are deliberately NOT kept in git: they are large,
# they are binary, and they are reproducible from this directory in one
# command.  Ship them with a release instead.
build/
.Xil/
__pycache__/
*.pyc

# Vivado's PS7 board-preset automation writes a summary into a directory named
# from an unset variable.  It is noise, not output.
NA/
