# Pin constraints for the GPSDO DDMTD front end on a PYNQ-Z2.
#
# GENERATED by gateware/gen_xdc.py from gen/design.py -- do not edit.
# 2026-09-13
#
# Every ball here was cross-checked in round 22 against the TUL
# schematic R12 sheet 4 and the PYNQ-Z2 Reference Manual v1.0.  Note
# that eight of these balls are SHARED WITH PMOD A, so Pmod A cannot be
# used while this board is fitted.

# ---- the helper clock -------------------------------------------
#
# Header pin 18, the only clock-capable pin on the Raspberry Pi header
# on BOTH the PYNQ-Z2 and the Icepi Zero.  gen/design.py asserts that
# nothing may reassign it.
#
# The PYNQ puts a 200 ohm series resistor in every header GPIO, which
# with the FPGA's input capacitance gives this clock a ~4.4 ns edge at
# the die.  That is slow for a clock input; if bring-up shows double
# clocking, that resistor is the reason.
set_property -dict {PACKAGE_PIN Y7 IOSTANDARD LVCMOS33} [get_ports {helper_clk}]  ;# header pin 18
create_clock -period 99.988 -name helper_clk [get_ports {helper_clk}]  ;# 10.0012344 MHz

# ---- the thirteen beats, ~1234 Hz ---------------------------------
set_property -dict {PACKAGE_PIN W10  IOSTANDARD LVCMOS33} [get_ports {beat[0]}]   ;# BEAT_00  header pin 23
set_property -dict {PACKAGE_PIN Y18  IOSTANDARD LVCMOS33} [get_ports {beat[1]}]   ;# BEAT_01  header pin 7
set_property -dict {PACKAGE_PIN Y16  IOSTANDARD LVCMOS33} [get_ports {beat[2]}]   ;# BEAT_02  header pin 27
set_property -dict {PACKAGE_PIN U7   IOSTANDARD LVCMOS33} [get_ports {beat[3]}]   ;# BEAT_03  header pin 11
set_property -dict {PACKAGE_PIN Y19  IOSTANDARD LVCMOS33} [get_ports {beat[4]}]   ;# BEAT_04  header pin 29
set_property -dict {PACKAGE_PIN V7   IOSTANDARD LVCMOS33} [get_ports {beat[5]}]   ;# BEAT_05  header pin 13
set_property -dict {PACKAGE_PIN U18  IOSTANDARD LVCMOS33} [get_ports {beat[6]}]   ;# BEAT_06  header pin 31
set_property -dict {PACKAGE_PIN U8   IOSTANDARD LVCMOS33} [get_ports {beat[7]}]   ;# BEAT_07  header pin 15
set_property -dict {PACKAGE_PIN W8   IOSTANDARD LVCMOS33} [get_ports {beat[8]}]   ;# BEAT_08  header pin 33
set_property -dict {PACKAGE_PIN V8   IOSTANDARD LVCMOS33} [get_ports {beat[9]}]   ;# BEAT_09  header pin 19
set_property -dict {PACKAGE_PIN Y8   IOSTANDARD LVCMOS33} [get_ports {beat[10]}]   ;# BEAT_10  header pin 35
set_property -dict {PACKAGE_PIN V10  IOSTANDARD LVCMOS33} [get_ports {beat[11]}]   ;# BEAT_11  header pin 21
set_property -dict {PACKAGE_PIN W9   IOSTANDARD LVCMOS33} [get_ports {beat[12]}]   ;# BEAT_12  header pin 37

# ---- the twelve pps returns, 1 Hz ---------------------------------
# There is no PPS_12: unit 13 is the null channel and has no pps.
set_property -dict {PACKAGE_PIN U19  IOSTANDARD LVCMOS33} [get_ports {pps[0]}]    ;# PPS_00   header pin 26
set_property -dict {PACKAGE_PIN V6   IOSTANDARD LVCMOS33} [get_ports {pps[1]}]    ;# PPS_01   header pin 8
set_property -dict {PACKAGE_PIN Y17  IOSTANDARD LVCMOS33} [get_ports {pps[2]}]    ;# PPS_02   header pin 28
set_property -dict {PACKAGE_PIN Y6   IOSTANDARD LVCMOS33} [get_ports {pps[3]}]    ;# PPS_03   header pin 10
set_property -dict {PACKAGE_PIN B20  IOSTANDARD LVCMOS33} [get_ports {pps[4]}]    ;# PPS_04   header pin 32
set_property -dict {PACKAGE_PIN C20  IOSTANDARD LVCMOS33} [get_ports {pps[5]}]    ;# PPS_05   header pin 12
set_property -dict {PACKAGE_PIN B19  IOSTANDARD LVCMOS33} [get_ports {pps[6]}]    ;# PPS_06   header pin 36
set_property -dict {PACKAGE_PIN W6   IOSTANDARD LVCMOS33} [get_ports {pps[7]}]    ;# PPS_07   header pin 16
set_property -dict {PACKAGE_PIN A20  IOSTANDARD LVCMOS33} [get_ports {pps[8]}]    ;# PPS_08   header pin 38
set_property -dict {PACKAGE_PIN F20  IOSTANDARD LVCMOS33} [get_ports {pps[9]}]    ;# PPS_09   header pin 22
set_property -dict {PACKAGE_PIN Y9   IOSTANDARD LVCMOS33} [get_ports {pps[10]}]    ;# PPS_10   header pin 40
set_property -dict {PACKAGE_PIN F19  IOSTANDARD LVCMOS33} [get_ports {pps[11]}]    ;# PPS_11   header pin 24

# ---- I2C to the Si5351, the thermometers, the DAC and the bridge --
# 2k2 pull-ups are already fitted on the PYNQ (R305-R308); the front-end
# board deliberately fits none.
set_property -dict {PACKAGE_PIN W18  IOSTANDARD LVCMOS33 PULLUP true} [get_ports {iic_sda_io}]  ;# I2C_SDA  header pin 3
set_property -dict {PACKAGE_PIN W19  IOSTANDARD LVCMOS33 PULLUP true} [get_ports {iic_scl_io}]  ;# I2C_SCL  header pin 5

# ---- timing ------------------------------------------------------
# Beats and pps are asynchronous to the PS clock and are taken into the
# helper domain through two-flop synchronisers, so they are declared
# false paths.  The measurement does NOT depend on their setup/hold
# against the helper: it depends on the counter value latched when the
# synchroniser sees the edge.
set_false_path -from [get_ports {beat[*]}]
set_false_path -from [get_ports {pps[*]}]

# The helper comes from the Si5351 on the front-end board and is not
# phase-related to anything inside the FPGA.  Without this Vivado tries
# to time every timestamp bit crossing out of the helper domain and
# reports thousands of failing endpoints that mean nothing -- the
# crossing is handled by the toggle-synchroniser in dmtd_capture, not by
# timing closure.
#
# The second group is 'every other clock' rather than clk_fpga_0 by
# name, so this is still correct for the bring-up variant, which runs
# the AXI fabric from the board's own 125 MHz oscillator instead.
#
# ONE group, deliberately.  set_clock_groups with a single -group means
# 'this group is asynchronous to every other clock in the design', and
# that is resolved at analysis time rather than when this file is read.
# Naming the other clocks -- or computing them from all_clocks -- makes
# the constraint depend on XDC ordering, and a clock created later (the
# PS7's clk_fpga_0, an MMCM output) then silently falls outside the
# group.  The symptom is thousands of failing CDC endpoints in a timing
# report that points at the design instead of at the constraint.
if {![llength [get_clocks -quiet helper_clk]]} {
    error "pins.xdc: helper_clk is not defined -- the create_clock above\
 did not match a port, so nothing below constrains anything."
}
set_clock_groups -asynchronous \
    -group [get_clocks -include_generated_clocks helper_clk]
